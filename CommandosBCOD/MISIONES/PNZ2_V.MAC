      .CLASS BICHO
      .BANDO NEUTRAL
      .VARIABLES [ EAngulo.180 CAngMarchaAtras ]
      .ANGULO $ANGULO
      .ENEGIA 500
      .TIP 2PZ2
      .VOLCOLISION [
        POLY
        [
          .H 40
          .VERT [ [ 45 30 ] [ -60 30 ] [ -60 -30 ] [ 45 -30 ] ]
        ]
      ]
      .BOXSELECCIONREL [ -35 -35 70 60 ]
      .LISTAS [ EJEC CHOC SELE ]
      .MASA 3500
      .GRAPH [
        .ANIM PNZ2
        .TILES 2
        .RENDERVOL [
          POLY
          [
            .H 20
            .VERT [ [ 45 30 ] [ -60 30 ] [ -60 -30 ] [ 45 -30 ] ]
          ]
        ]
      ]
      .ORGANOS [
        .MOTOR [ MotorTanque [
           .VELMAX 2
           .ANGREV $AngMarchaAtras
        ] ]
      ]
      .ACCIONES [
        [
          acExplotaVeh
          [
          .CARISMA 900 .RADIO 200 .DANO 180 .TIEMPO 200
          .IMPACTOS [ .DISPARO -1 .BOMBA 1 .PEPINAZOTANQUE 1 .EXPLOSIONMENOR 1 ]
          .SONFIS XPLO
          ]
        ]
        [
          acTorreta
          [
            .RAFAGA 10
            .ALCANCE 1000
            .RECARGA 5
            .IMPACTO 110
            .ARCO 10
            .ALCANCEMINIMO 50
            .TORRETA [ .ANIM PNZ2DIS .HOTSPOTSEQUENCES [ DISPAROPNZ2 DISPAROPNZ2 ] .POSICION [ 0 0 20 ] ]
            .SONIDOMETRALLETA TANQUE
            .CARISMA 100
          ]
        ]
        [
          AcPilotaje
          [
            .CARISMA 100
						.WAV [ .SONIDOARRANQUE TANA .SONIDOAVANCE TANI .SONIDORALENTI TANR .SONIDOPARAR TANP ]
            .FUERZA 200
            .TIPOVEH TIERRA
            .MINVEL 5
            .MAXVEL 10
            .DISPARA 1
            .CHIVABANDO 1
            .NOSIGUECHIVANDO 1
            .INFO
            [
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
            ]
          ]
        ]
        [
          acPisar
          [
            .CARISMA 50
            .VEHICLE [
              [ .POS [ 50 25 ] ]
              [ .POS [ -60 25 ] ]
              [ .POS [ -60 -20 ] ]
              [ .POS [ 50 -20 ] ]
            ]
          ]
        ]
      ]
      .CONTENEDOR 1
      .OCLU 1

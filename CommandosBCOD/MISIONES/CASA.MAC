# VARIABLES: La primera letra indica tipo C-Caracteres (cadena normal)
# P-Punto G-Grafico A-Accion T-TokenBicho
# Segun el tipo se crea un control adecuado en la ventana de edicion del bicho:
# Un punto tiene un boton que permite hacer clic en pantalla para marcarlo
# Un Grafico se asocia a una combobox con todos los ANM para seleccionar uno
# Una accion tiene un boton que llama a la ventana de edicion de esa accion. Ej: AacPatrulla
# (Pueden crearse mas tipos de variables para dar nuevas funcionalidades de macro)

.VARIABLES [ AAcCasaLogica VTocarWav.1 ]
.BANDO NEUTRAL
.ANGULO 0
.BUILDING 0
.TIP 0CAS
.VOLCOLISION [ CILINDRO [ .R 10 .H 40 ] ]
.BOXSELECCIONREL [ -15 -55 31 50 ]
.LISTAS [ EJEC CHOC SELE ]
.MASA 100
.DETECTAEXPLOSION 1
.ENEGIA 1
.CONTENEDOR 1
.SEHUNDE 0
.NOSOLIDO 1
.ACCIONES
[
  [
    acCasa
    [
      .CARISMA 100
      .WAV [ .SONIDOCERRAR PCAS .TOCARWAV $TocarWav ]
      .XYZENTRADA $XYZ
      .XYZSALIDA $XYZ
      .DOOR 10
      .RADIO 30
      .ANGULOABIERTA 0
      .ANGULOCERRADA 135
      .CARCEL 0
      .NUMREGENSOLDIERS 0
    ]
  ]
  [ $acCasaLogica [ .CARISMA 200 ] ]
]


# VARIABLES: La primera letra indica tipo C-Caracteres (cadena normal) P-Punto G-Grafico A-Accion Concreta X-Accion elegible
# Segun el tipo se crea un control adecuado en la ventana de edicion del bicho:
# Un punto tiene un boton que permite hacer clic en pantalla para marcarlo
# Un Grafico se asocia a una combobox con todos los ANM para seleccionar uno
# Una accion tiene un boton que llama a la ventana de edicion de esa accion. Ej: AacPatrulla
# (Pueden crearse mas tipos de variables para dar nuevas funcionalidades de macro)

.CLASS BICHO
.VARIABLES
[
 EAngulo.180 CUmbralNerviosismo CAngBarrido
 GGrafico.ALEMAN2 NReactividades
 AAcPatrulla
 FRuta
 VTENGOTABACO.1
]
.BANDO ALEMAN
.ANGULO $Angulo
.VOLCOLISION [ CILINDRO [ .R 10 .H 29 ] ]
.GRAPH [ .ANIM $Grafico .RENDERVOL [ CILINDRO [ .R 10 .H 40 ] ] ]
.LISTAS [ EJEC CHOC SELE VISI ]
.REACTIVIDADES $Reactividades
.MASA 100
.SEHUNDE 1
.ACCIONES [
  [ AcMuerte [ .CARISMA 999 ] ]
  [
    AcBap2
    [
      .CARISMA 600 .NERVIOSISMO $UmbralNerviosismo .TENGOTABACO $TENGOTABACO
      .RUTA $Ruta
    ]
  ]
  [ AcDisparar [ .CARISMA 500 ] ]
  [ AcVigilar [ .CARISMA 400 .ANGBARRIDO $AngBarrido ] ]
  [ AcBuscador [ .CARISMA 300 ] ]
  [ $AcPatrulla [ .CARISMA 200 ] ]
  [ AcUsahab [ .CARISMA 150 ] ]
  [ AcPisar [ .CARISMA 100 ] ]
  ]
.ORGANOS [
  .VISTA [ Vista01 [ ] ]
  .MOTOR [ MotorAndante [ ] ]
  .OIDO [ Oido01 [ ] ]
]


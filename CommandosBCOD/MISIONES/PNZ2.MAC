      .CLASS BICHO
      .BANDO NEUTRAL
      .VARIABLES [ EAngulo.180 TPiloto NReactividades CNoVerHasta AAcPatrulla CAngMarchaAtras ]
      .ANGULO $ANGULO
      .REACTIVIDADES $REACTIVIDADES
      .ENEGIA 500
      .TIP 2PZ2
      .VOLCOLISION [
        POLY
        [
          .H 40
          .VERT [ [ 45 30 ] [ -60 30 ] [ -60 -30 ] [ 45 -30 ] ]
        ]
      ]
      .BOXSELECCIONREL [ -35 -35 70 60 ]
      .LISTAS [ EJEC CHOC SELE ]
      .MASA 3500
      .GRAPH [
        .ANIM PNZ2
        .TILES 2
        .RENDERVOL [
          POLY
          [
            .H 20
            .VERT [ [ 45 30 ] [ -60 30 ] [ -60 -30 ] [ 45 -30 ] ]
          ]
        ]
      ]
      .ORGANOS [
        .MOTOR [ MotorTanque [
           .VELMAX 2
           .ANGREV $AngMarchaAtras
           .WAV TANQ
          ] ]
        .VISTA [
          Vista02
          [
            .VOL [
              POLY
              [
                .H 20
                .VERT [ [ 63 -32 ] [ 130 -32 ] [ 130 32 ] [ 63 32 ] ]
              ]
            ]
          ]
        ]
      ]
      .ACCIONES [
        [
          acExplotaVeh
          [
            .CARISMA 900 .RADIO 200 .DANO 180 .TIEMPO 200
            .IMPACTOS [ .DISPARO 1000 .BOMBA 1 .PEPINAZOTANQUE 1 .EXPLOSIONMENOR 1 ]
            .SONFIS XPLO
          ]
        ]
        [
          acTorreta
          [
            .RAFAGA 10
            .ALCANCE 1000
            .RECARGA 5
            .IMPACTO 110
            .ARCO 10
            .ALCANCEMINIMO 50
            .TORRETA [ .ANIM PNZ2DIS .HOTSPOTSEQUENCES [ DISPAROPNZ2 DISPAROPNZ2 ] .POSICION [ 0 0 20 ] ]
            .SONIDOMETRALLETA TANQUE
            .CARISMA 100
          ]
        ]
        [
          AcPilotaje
          [
            .CARISMA 100
            .FUERZA 200
            .TIPOVEH TIERRA
            .MINVEL 5
            .MAXVEL 10
            .DISPARA 1
            .CHIVABANDO 1
            .INFO [ [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ] ]
          ]
        ]
        [
          acPisar
          [
            .CARISMA 50
            .VEHICLE [
              [ .POS [ 50 25 ] ]
              [ .POS [ -60 25 ] ]
              [ .POS [ -60 -20 ] ]
              [ .POS [ 50 -20 ] ]
            ]
          ]
        ]
      ]
      .CONTENEDOR 1
      .OCLU 1
      .ELEMENTOS [
        [
          .CLASS BICHO
          .BANDO ALEMAN
          .REACTIVIDADES $REACTIVIDADES
          .LISTAS EJEC
          .VOLCOLISION [ CILINDRO [ .R 10 .H 29 ] ]
          .ACCIONES [
            [ acMuerte [ .CARISMA 500 ] ]
            [ AcUsaHab [ .CARISMA 400 .HABILIDAD TIERRA ] ]
            [ acCTanque [ .CARISMA 300 .NOVERHASTA $NOVERHASTA ] ]
            [ $AcPatrulla [ .CARISMA 200 ] ]
            [ AcVigilar [ .CARISMA 100 .ANGBARRIDO 155 ] ]
          ]
          .MASA 100
          .ORGANOS [
            .VISTA [
              Vista01
              [
                .ALT 150
                .MOD 500
                .ANG 70
                .CABEZA 0
                .PASO 90
              ]
            ]
          ]
          .TOKEN $PILOTO
        ]
      ]

          acExplotaVeh
          [
            .CARISMA 900 .RADIO 200 .DANO 180 .TIEMPO 200
            .IMPACTOS [ .ATROPELLO 1 .DISPARO 30 .BOMBA 1 .PEPINAZOTANQUE 1 .EXPLOSIONMENOR 1 ]
            .SONFIS XPLO
          ]
        ]
        [
          acPilotaje
          [
            .CARISMA 200
						.WAV [ .SONIDOARRANQUE CAMA .SONIDORALENTI CAMR .SONIDOAVANCE CAMI .SONIDOPARAR CAMP ]
            .TIPOVEH TIERRA
            .FUERZA 150
            .CHIVABANDO 1
            .INFO [
              [ .ENTRADA [ 35 -30 0 ] .SALIDA [ 35 -30 0 ] ]
              [ .ENTRADA [ 35 30 0 ] .SALIDA [ 35 30 0 ] ]
              [ .ENTRADA [ -55 0 0 ] .SALIDA [ -55 0 0 ] ]
              [ .ENTRADA [ -55 0 0 ] .SALIDA [ -55 0 0 ] ]
              [ .ENTRADA [ -55 0 0 ] .SALIDA [ -55 0 0 ] ]
              [ .ENTRADA [ -55 0 0 ] .SALIDA [ -55 0 0 ] ]
            ]
          ]
        ]
        [ $AcPatrulla [ .CARISMA 300 ] ]

            .VEHICLE [
              [ .POS [ 50 25 ] ]
              [ .POS [ -60 25 ] ]
              [ .POS [ -60 -25 ] ]
              [ .POS [ 50 -25 ] ]
            ]
          ]
        ]
      ]

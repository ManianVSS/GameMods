# VARIABLES: La primera letra indica tipo C-Caracteres (cadena normal) P-Punto
# G-Grafico A-Accion Concreta X-Accion elegible
# Segun el tipo se crea un control adecuado en la ventana de edicion del bicho:
# Un punto tiene un boton que permite hacer clic en pantalla para marcarlo
# Un Grafico se asocia a una combobox con todos los ANM para seleccionar uno
# Una accion tiene un boton que llama a la ventana de edicion de esa accion. Ej: AacPatrulla
# (Pueden crearse mas tipos de variables para dar nuevas funcionalidades de macro)

.CLASS BICHO
.VARIABLES
[
 EAngulo.180 NReactividades CAngBarrido AAcPatrulla CAngMarchaAtras
]
.BANDO NEUTRAL
.ANGULO $Angulo
.GRAPH [
  .ANIM TANQUETA
  .RENDERVOL [
    POLY
    [
      .H 20
      .VERT [
        [ 55 23 ]
        [ -75 23 ]
        [ -75 -23 ]
        [ 55 -23 ]
      ]
    ]
  ]
]
.VOLCOLISION
[
  POLY
  [
    .H 30
      .VERT [
        [ 55 23 ]
        [ -75 23 ]
        [ -75 -23 ]
        [ 55 -23 ]
      ]
  ]
]
.BOXSELECCIONREL [ -35 -35 70 60 ]
.LISTAS [ EJEC CHOC SELE ]
.MASA 500
.SEHUNDE 1
.TIP 2SD2
.ACCIONES
[
  [
    acExplotaVeh
    [
          .CARISMA 900 .RADIO 200 .DANO 180 .TIEMPO 200
          .IMPACTOS [ .DISPARO 500 .BOMBA 1 .PEPINAZOTANQUE 1 .EXPLOSIONMENOR 1 ]
          .SONFIS XPLO
    ]
  ]
  [
    acPilotaje
    [
      .CARISMA 200
      .TIPOVEH TIERRA
      .FUERZA 150
      .NORMALVEL 5
      .CHIVABANDO 1
            .INFO
            [
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
              [ .ENTRADA [ 0 0 0 ] .SALIDA [ 0 0 0 ] ]
            ]
      .DISPARA 1
      .PARAYDISPARA 1
    ]
  ]
  [
    acTorreta
    [
      .CARISMA 100
      .TIPODISPARO METRALLETA
      .SONIDOMETRALLETA TANQUE
      .ALCANCE 600
      .ALCANCEMINIMO 150
      .TORRETA [ .ANIM T-TANQTA .HOTSPOTSEQUENCE [ DISPAROLANCHA ] .POSICION [ 0 0 30 ] ]
      .BANDO [ ]
      .IMPACTO [ ]
      .ARCO [ ]
      .RAFAGA [ ]
      .RECARGA [ ]
    ]
  ]
  [
    acPisar
    [
      .CARISMA 50
      .VEHICLE [
        [ .POS [ 30 18 ] ]
        [ .POS [ 4 18 ] ]
        [ .POS [ -23 18 ] ]
        [ .POS [ -50 18 ] ]
        [ .POS [ -50 -18 ] ]
        [ .POS [ 4 -18 ] ]
        [ .POS [ -23 -18 ] ]
        [ .POS [ 30 -18 ] ]
      ]
    ]
  ]
]
.ORGANOS
[
  .MOTOR [ MotorAuto [
    .WAV CAMN
    .ANGREV $AngMarchaAtras
  ] ]
]
.CONTENEDOR 1
.OCLU 1
.DETECTAEXPLOSION 0
.BUILDING 0
.SEHUNDE 0
.ESCONDUCTOR 0
